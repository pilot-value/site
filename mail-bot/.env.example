# PILOT VALUE mail-bot 設定（このファイルをコピーして .env を作成）
# cp mail-bot/.env.example mail-bot/.env  してから値を埋める。.env は Git 管理外。

# ── Supabase（service_role キー：管理画面 Settings → API → service_role secret）──
# ※ service_role は RLS を無視する強力なキー。絶対に公開・コミットしないこと。
SUPABASE_URL=https://vzgmnkrggrwtsrpqndsm.supabase.co
SUPABASE_SERVICE_KEY=ここに service_role キー

# ── Resend（https://resend.com → API Keys）──
RESEND_API_KEY=ここに Resend の API キー

# ── Anthropic（https://platform.claude.com → API Keys）──
# 口コミの日↔英 翻訳をローカルで試すときだけ必要（node translate-eval.mjs）。
# 本番の翻訳・明細解析は Supabase の Edge Function secret（同じ名前）を読むので、ここは開発用。
# ⚠️ Supabase の secret は関数ごとではなくプロジェクト単位。translate-review と
#    parse-payslip が同じ ANTHROPIC_API_KEY を読むので、差し替えると両方に効く。
ANTHROPIC_API_KEY=ここに Anthropic の API キー

# 送信元（要：pilot-value.com の送信ドメイン認証 SPF/DKIM/DMARC を Resend で完了）
FROM_EMAIL=PILOT VALUE <noreply@pilot-value.com>

# ── 管理者通知の宛先 ──
ADMIN_EMAIL=info@pilot-value.com

# ── 会員配信（send.mjs）用：解除リンクの生成に使うサイトURL ──
SITE_URL=https://pilot-value.com

# ── 自分のテスト用アカウント（node db/usage.mjs が実績から外す）──
# カンマ区切り。* は任意の文字列に当たる（Gmail の +別名は * が真ん中に来る）。
# ★ここを空のままにすると、自分の動作確認が「利用者の実績」として数えられる。
#   db/usage.mjs は空のとき警告を出すが、数字は素のまま出るので必ず埋めること。
# ★このリポジトリは PUBLIC。実在のアドレスを .mjs / .md / .html に書かないこと。
#   ここ（.env）は gitignore 済みなので書いてよい唯一の場所。
PV_TEST_EMAILS=jibun@example.com,jibun+*@example.com
